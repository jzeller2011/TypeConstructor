<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project parameters" Width="820" Height="680" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12">
    <DockPanel Margin="14">
        <TextBlock x:Name="intro_tb" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="save_btn" Content="Save to project" Padding="18,4" IsDefault="True"/>
            <Button x:Name="cancel_btn" Content="Cancel" Padding="12,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Name segments: which parameter holds each one in this project"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel x:Name="map_panel"/>
                <TextBlock Text="Extra parameters to show and filter by (not part of the name)"
                           FontWeight="Bold" Margin="0,16,0,2"/>
                <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="Ticked parameters appear as optional fields and list columns, and are written when a type is created. They don't affect whether a type counts as a duplicate."/>
                <StackPanel x:Name="extra_panel"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
